{
	"$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "master"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 4,
		"lineEnding": "lf"
	},
	"files": {
		"includes": [
			"**",
			"!docs/*",
			"!node_modules/*",
			"!dist/*",
			"!coverage/*",
			"!.vscode/*",
			"!.github/*",
			"!.idea/*"
		]
	}
}